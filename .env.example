VITE_API_BASE_URL=http://localhost:8080/api
# Optional. When set, only chatbot calls use this base URL; all other APIs stay on VITE_API_BASE_URL.
VITE_CHATBOT_API_BASE_URL=http://localhost:8081/api
VITE_GOOGLE_AUTH_ENABLED=true
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional public presentation-data IndexedDB cache. Set false to retain the
# Phase 2 HTTP/ETag-only public data flow for troubleshooting.
VITE_PUBLIC_BROWSER_CACHE_ENABLED=true
